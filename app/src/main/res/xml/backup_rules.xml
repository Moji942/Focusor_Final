<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude sensitive data from backup -->
    <exclude domain="sharedpref" path="secure_prefs.xml" />
    <exclude domain="sharedpref" path="api_keys.xml" />
    <exclude domain="database" path="focusor_database.db" />
    <exclude domain="database" path="focusor_database.db-shm" />
    <exclude domain="database" path="focusor_database.db-wal" />
    
    <!-- Include only necessary files -->
    <include domain="file" path="." />
    <include domain="sharedpref" path="user_preferences.xml" />
    <include domain="sharedpref" path="theme_preferences.xml" />
</full-backup-content>